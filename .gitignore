/vendor/
.claude/settings.local.json
.env
# Any renamed/backup copy of .env (e.g. .envqwer) holds the same secrets.
.env*
*.log
.DS_Store
Thumbs.db
/temporary screenshots/
node_modules/

# Runtime uploads live on a Railway Volume in production — don't commit
# user-uploaded content, but keep the folder structure (see .gitkeep files)
# so it exists even before a volume is first mounted.
/assets/uploads/**
!/assets/uploads/
!/assets/uploads/*/
!/assets/uploads/*/.gitkeep

# Automatic pre-restore safety backups (api/backup/import.php) — a
# short-lived local safety net taken right before a Restore overwrites
# the live database, not a real backup archive (those are downloaded by
# the admin, never stored in the repo/container long-term).
/storage/backups/**
!/storage/backups/
!/storage/backups/.gitkeep
