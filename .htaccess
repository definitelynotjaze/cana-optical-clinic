# Local dev environment — always serve fresh HTML/CSS/JS so browser
# caching never masks code changes during active development.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Block direct web access to secrets/config — matters on Apache hosts
# (e.g. Hostinger) where, unlike Railway's PHP built-in server, a file
# like .env would otherwise be served as plain text if requested directly.
<FilesMatch "(^\.env|\.sql$|composer\.(json|lock)|\.gitignore$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
